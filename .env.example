# ==============================================================================
# MerchantMesh — Environment Configuration Template
# Copy this file to .env before starting the server:
#   cp .env.example .env
# ==============================================================================

# Application Environment: 'development' or 'production'
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. LLM & Inference Configuration (Groq Cloud)
# Get your free API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_LLM_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=openai/gpt-oss-120b


# ------------------------------------------------------------------------------
# 2. Razorpay API & Webhook Configuration
# Get Test API Keys at: https://dashboard.razorpay.com/app/keys
# (Leave empty or use dummy values to run in High-Fidelity Local Simulation Mode)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. Administrative Security
# Required for destructive database resets and admin sweep operations
# ------------------------------------------------------------------------------
ADMIN_API_KEY=demo_admin_key_mesh
